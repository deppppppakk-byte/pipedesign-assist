{
  "name": "@vayraxa/collaboration-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "provision-user": "tsx src/provision-user.ts",
    "test:auth": "tsx src/auth-selftest.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "start:cloud": "npm run migrate:prod && npm start",
    "smoke:cloud": "tsx src/cloud-smoke.ts"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "typescript": "^5.9.2",
    "@types/node": "^24.5.2",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
